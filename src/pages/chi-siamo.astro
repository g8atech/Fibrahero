---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NetworkMap from '../components/NetworkMap.astro';
import CtaBand from '../components/CtaBand.astro';
import { SEDI } from '../data/site';
---
<Base
  title="Chi siamo — FibraHero è G8A Technology"
  description="FibraHero è il servizio di connettività per aziende di G8A Technology, che da circa quindici anni segue l'informatica delle imprese tra Varese, Milano e Lecco."
>
  <section class="section section--white">
    <div class="wrap about">
      <div>
        <Breadcrumbs items={[{ name: 'Chi siamo', href: '/chi-siamo' }]} />
        <h1>FibraHero è G8A Technology</h1>
        <p class="lead">Da circa quindici anni seguiamo computer, reti, stampanti e server delle aziende del territorio. FibraHero nasce perché la connessione è la parte che, quando si ferma, blocca tutto il resto.</p>
        <p>G8A è nata come ditta individuale dei fratelli Giuseppe e Antonio Arrigo ed è cresciuta fino a una rete di sedi tra le province di Varese, Milano e Lecco. Oggi i nostri tecnici gestiscono l'informatica di uffici, studi e capannoni: PC in noleggio, server, backup, sicurezza.</p>
        <p>Con FibraHero siamo noi l'operatore. Questo cambia una cosa sola, ma importante: quando c'è un problema non esiste più il rimpallo tra chi fornisce la linea e chi gestisce la rete. Rispondiamo noi, per entrambe.</p>
      </div>
      <div class="about__map"><NetworkMap tone="onLight" /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Le nostre sedi</h2>
      <ul class="sedi">
        {SEDI.map((s) => (
          <li>
            <h3>{s.city}</h3>
            <p>{s.address}<br />{s.cap} {s.city} ({s.province})</p>
            {s.operativa && <p class="sedi__op">Sede operativa e magazzino</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <h2>Fanno parte del gruppo G8A</h2>
      <ul class="brands">
        <li><strong>G8A Technology</strong><span>Informatica gestita per aziende, noleggio PC e server</span></li>
        <li><strong>TonerHero</strong><span>Toner e cartucce per uffici, nei negozi e online</span></li>
        <li><strong>RiparoHero</strong><span>Riparazioni di smartphone, tablet e computer</span></li>
        <li><strong>FibraHero</strong><span>Connettività per aziende</span></li>
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .about { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .sedi { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 2.5rem; }
  .sedi li { border-top: 3px solid var(--fiber); padding-top: 1rem; }
  .sedi p { margin: 0; color: var(--muted); }
  .sedi .sedi__op { color: var(--ink); font-weight: 700; margin-top: 0.4rem; }
  .brands { list-style: none; padding: 0; margin: 1.5rem 0 0; border-top: 2px solid var(--ink); }
  .brands li { display: grid; grid-template-columns: 14rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .brands span { color: var(--muted); }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } .sedi { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .sedi { grid-template-columns: 1fr; } .brands li { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
