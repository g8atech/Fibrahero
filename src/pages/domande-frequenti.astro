---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import LightStreaks from '../components/LightStreaks.astro';
import CtaBand from '../components/CtaBand.astro';
import { FAQ_GENERALI } from '../data/faq';
import { SERVIZI } from '../data/servizi';

const all = [...FAQ_GENERALI, ...SERVIZI.flatMap((s) => s.faq)];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: all.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Domande frequenti sulla fibra per aziende"
  description="Risposte sulla differenza tra FTTH e FTTC, sui profili simmetrici, firewall, backup della rete, centralino cloud VoIP, noleggio dispositivi e assistenza FibraHero."
  jsonLd={[faqSchema]}
>
  <section class="pagehead">
    <LightStreaks />
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Domande frequenti', href: '/domande-frequenti' }]} />
      <h1>Domande frequenti</h1>
      <p class="lead">Se non trovi la tua risposta, scrivici su WhatsApp: ti risponde un tecnico.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <Faq items={FAQ_GENERALI} heading="FibraHero e assistenza" />
      {SERVIZI.map((s) => <div class="block"><Faq items={s.faq} heading={s.name} /></div>)}
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .block { margin-top: 3rem; }
</style>
