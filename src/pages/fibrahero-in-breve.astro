---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LightStreaks from '../components/LightStreaks.astro';
import CtaBand from '../components/CtaBand.astro';
import { FATTI, DOMANDE } from '../data/inbreve';
import { SERVIZI } from '../data/servizi';
import { SEDI, SITE } from '../data/site';

const updated = new Date().toISOString().slice(0, 10);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: DOMANDE.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const localBusinesses = SEDI.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: `FibraHero by G8A – ${s.city}`,
  parentOrganization: { '@id': `${SITE.url}/#organization` },
  telephone: '+39 ' + SITE.phone,
  url: SITE.url,
  address: { '@type': 'PostalAddress', streetAddress: s.address, postalCode: s.cap, addressLocality: s.city, addressRegion: s.province, addressCountry: 'IT' },
  geo: { '@type': 'GeoCoordinates', latitude: s.lat, longitude: s.lng },
}));
---
<Base
  title="FibraHero in breve"
  description="Chi è FibraHero, cosa offre, per chi, dove opera e come si contatta: i fatti essenziali sull'operatore di connettività per aziende di G8A Technology."
  jsonLd={[faqSchema, ...localBusinesses]}
>
  <section class="pagehead">
    <LightStreaks />
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'FibraHero in breve', href: '/fibrahero-in-breve' }]} />
      <h1>FibraHero in breve</h1>
      <p class="lead">I fatti essenziali, in poche righe. Aggiornato al <time datetime={updated}>{new Date(updated).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}</time>.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <dl class="facts">
        {FATTI.map((f) => (<div><dt>{f.k}</dt><dd>{f.v}</dd></div>))}
      </dl>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap two">
      <div>
        <h2>Servizi</h2>
        <ul class="plain">
          {SERVIZI.map((s) => <li><a href={`/${s.slug}`}><strong>{s.name}</strong></a> — {s.short}</li>)}
        </ul>
      </div>
      <div>
        <h2>Sedi G8A</h2>
        <ul class="plain">
          {SEDI.map((s) => <li><strong>{s.city}</strong> — {s.address}, {s.cap} ({s.province}){s.operativa && ' · sede operativa'}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Domande e risposte brevi</h2>
      <dl class="qa">
        {DOMANDE.map((d) => (<div><dt>{d.q}</dt><dd>{d.a}</dd></div>))}
      </dl>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .facts { margin: 0; border-top: 3px solid var(--ink); }
  .facts div { display: grid; grid-template-columns: 14rem 1fr; gap: 1.5rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  .facts dt { font-weight: 800; text-transform: uppercase; font-stretch: 85%; font-variation-settings: 'wdth' 85; color: var(--blue); }
  .facts dd { margin: 0; max-width: 64ch; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); }
  .plain { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.75rem; }
  .plain li { color: var(--muted); }
  .plain strong { color: var(--ink); }
  .qa { margin: 1.5rem 0 0; display: grid; gap: 1.25rem; max-width: 52rem; }
  .qa dt { font-weight: 700; font-size: 1.08rem; }
  .qa dd { margin: 0.25rem 0 0; color: var(--muted); }
  @media (max-width: 760px) {
    .facts div { grid-template-columns: 1fr; gap: 0.3rem; }
    .two { grid-template-columns: 1fr; }
  }
</style>
