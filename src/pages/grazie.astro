---
import Base from '../layouts/Base.astro';
---
<Base title="Richiesta ricevuta" description="Abbiamo ricevuto la tua richiesta di verifica copertura FibraHero." noindex>
  <section class="section">
    <div class="wrap">
      <h1>Richiesta ricevuta</h1>
      <p class="lead">Verifichiamo la copertura al tuo indirizzo e ti richiama un tecnico G8A della tua zona.</p>
      <a class="btn btn--ghost" href="/">Torna alla home</a>
    </div>
  </section>
  <script is:inline>
    // Solo dopo un invio vero del modulo (non a chi apre /grazie direttamente) e una volta sola.
    try {
      var da = sessionStorage.getItem('fh_modulo_inviato');
      if (da) { sessionStorage.removeItem('fh_modulo_inviato'); (window.dataLayer = window.dataLayer || []).push({ event: 'contatto', canale: 'modulo', pagina: da }); }
    } catch (e) {}
  </script>
</Base>
