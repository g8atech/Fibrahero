---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LightStreaks from '../components/LightStreaks.astro';
import Press from '../components/Press.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import heroImg from '../assets/hero-fibrahero.png';
import rack from '../assets/rack.png';
import { SITE, SEDI, waLink } from '../data/site';
import { SERVIZI } from '../data/servizi';
import { COMUNI } from '../data/comuni';
import { FAQ_GENERALI } from '../data/faq';

const faq = FAQ_GENERALI.slice(0, 5);
const highlights = [
  { icon: 'fibra', t: 'Fibra ultraveloce', d: 'FTTH e FTTC, stabile e simmetrica.' },
  { icon: 'assistenza', t: 'Assistenza diretta', d: 'Nessun call center, solo persone che risolvono.' },
  { icon: 'firewall', t: 'Firewall e rete gestiti', d: 'Sicurezza e dispositivi sotto controllo.' },
  { icon: 'voip', t: 'Centralino cloud', d: 'Numeri, interni e code, ovunque tu sia.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'FibraHero by G8A', url: SITE.url, inLanguage: 'it-IT' };
---
<Base
  title="FibraHero — Internet superveloce per aziende con assistenza dedicata"
  description="FibraHero by G8A è l'operatore per aziende: fibra FTTH/FTTC simmetrica, firewall, backup della rete e centralino cloud VoIP con assistenza diretta, tra Varese, Milano e Lecco."
  jsonLd={[website, faqSchema]}
>
  <section class="hero">
    <LightStreaks />
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__tag">Operatore per aziende</p>
        <h1>
          <span class="hero__big">Superveloce</span>
          <span class="hero__sub">con assistenza dedicata</span>
        </h1>
        <p class="hero__lead">Internet gestito per aziende, con firewall e centralino. La linea, la rete e i dispositivi li segue la stessa squadra di tecnici G8A, e per qualsiasi problema scrivi direttamente a noi.</p>
        <div class="hero__actions">
          <a class="btn btn--wa" href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={22} /> Scrivici al {SITE.phone}</a>
          <a class="btn btn--ghost" href="/verifica-copertura">Verifica copertura</a>
        </div>
        <p class="hero__note">Solo per aziende, professionisti e partite IVA.</p>
      </div>
      <div class="hero__visual">
        <div class="hero__badge">Naviga oltre i limiti!</div>
        <Image src={heroImg} alt="Il supereroe FibraHero che sfreccia tra le linee della fibra" widths={[420, 640, 840]} sizes="(max-width: 900px) 90vw, 560px" loading="eager" fetchpriority="high" />
      </div>
    </div>
    <ul class="wrap hero__strip">
      {highlights.map((h) => (
        <li><Icon name={h.icon} size={30} /><div><strong>{h.t}</strong><span>{h.d}</span></div></li>
      ))}
    </ul>
  </section>

  <Press />

  <section class="section">
    <div class="wrap why">
      <div>
        <h2>Perché <span class="accent">noi</span></h2>
        <hr class="rule" />
        <p class="why__claim"><span class="accent">FibraHero è un operatore dedicato alle aziende,</span> specializzato nella gestione completa della tua rete.</p>
        <p>Con un grande operatore hai la linea e un numero verde. Con FibraHero hai un partner che segue connessione, rete, firewall e telefonia, e che conosce la tua azienda perché ci è già stato.</p>
      </div>
      <ul class="cmp">
        <li><span class="cmp__no">Call center e operatori a turno</span><span class="cmp__yes">Tecnici G8A specializzati, sempre reperibili</span></li>
        <li><span class="cmp__no">"Il guasto è sul tuo router"</span><span class="cmp__yes">Linea, router e rete interna gestiti insieme</span></li>
        <li><span class="cmp__no">Apparati da comprare e aggiornare</span><span class="cmp__yes">Dispositivi a noleggio, sempre aggiornati</span></li>
        <li><span class="cmp__no">Offerte pensate per le famiglie</span><span class="cmp__yes">Solo aziende e partite IVA</span></li>
      </ul>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <h2>Tutto quello che serve alla tua rete</h2>
      <p class="lead">Un partner unico, tutto sotto controllo. Semplifichiamo la tecnologia, per aiutare la tua azienda a crescere.</p>
      <ul class="svc">
        {SERVIZI.map((s) => (
          <li>
            <a href={`/${s.slug}`}>
              <span class="svc__icon"><Icon name={s.icon} size={30} /></span>
              <h3>{s.name}</h3>
              <p>{s.short}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--night support">
    <LightStreaks />
    <div class="wrap support__grid">
      <div>
        <h2>Assistenza <span class="accent">diretta</span></h2>
        <p class="lead">Supporto tecnico dedicato e reperibile, interventi rapidi gestiti da tecnici specializzati. Nessun call center, solo persone che risolvono.</p>
        <ol class="steps">
          <li><strong>Ci scrivi su WhatsApp</strong><span>Al {SITE.phone}, lo stesso numero per offerte e assistenza.</span></li>
          <li><strong>Verifichiamo da remoto</strong><span>Linea, router, firewall e rete: li gestiamo noi, quindi li vediamo.</span></li>
          <li><strong>Se serve, veniamo in sede</strong><span>Dalla sede G8A più vicina, tra Varese, Milano e Lecco.</span></li>
        </ol>
        <a class="btn btn--wa" href={waLink('Ciao FibraHero, ho bisogno di assistenza sulla linea.')} target="_blank" rel="noopener"><Icon name="whatsapp" size={22} /> Assistenza su WhatsApp</a>
      </div>
      <Image class="support__rack" src={rack} alt="Armadio di rete con apparati e cablaggio gestiti da FibraHero" width={141} loading="lazy" />
    </div>
  </section>

  <section class="section">
    <div class="wrap area">
      <div>
        <h2>Vicini alla tua azienda</h2>
        <p class="lead">Le aziende che seguiamo sono a portata di una sede G8A. Per questo un intervento non diventa un'attesa di giorni.</p>
        <ul class="sedi">
          {SEDI.map((s) => (
            <li><strong>{s.city}</strong>{s.operativa && <span class="sedi__tag">sede operativa</span>}<br />{s.address}, {s.cap} ({s.province})</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="area__h">Fibra aziendale per comune</h2>
        <ul class="towns">
          {COMUNI.map((c) => <li><a href={`/fibra-aziendale/${c.slug}`}>{c.name}</a></li>)}
        </ul>
        <p><a href="/fibra-aziendale">Tutte le zone servite</a></p>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <Faq items={faq} />
      <p class="more"><a href="/domande-frequenti">Altre domande</a></p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    position: relative; overflow: hidden; color: #fff;
    background: radial-gradient(110% 120% at 75% 30%, #1d4fb0 0%, #0f2a66 30%, var(--navy) 55%, var(--night) 100%);
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(1rem, 4vw, 3rem); align-items: center; }
  .hero__tag { display: inline-block; font-weight: 700; color: var(--cyan); border: 1px solid rgba(111,214,255,.4); border-radius: 999px; padding: 0.25rem 0.85rem; font-size: 0.92rem; margin-bottom: 1.25rem; }
  .hero h1 { margin-bottom: 1.25rem; }
  .hero__big {
    display: block;
    font-size: clamp(3.4rem, 9vw, 7.2rem);
    line-height: 0.9;
    background: linear-gradient(180deg, #e9f6ff 0%, #8fd0ff 45%, #2f8bff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 22px rgba(47,139,255,.45));
  }
  .hero__sub { display: block; font-size: clamp(1.9rem, 4.4vw, 3.4rem); color: #fff; margin-top: 0.35rem; }
  .hero__lead { font-size: 1.18rem; color: #cbd8ee; max-width: 48ch; }
  .hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .hero__note { font-size: 0.9rem; color: #94a8cc; margin-top: 0.9rem; }
  .hero__visual { position: relative; }
  .hero__visual :global(img) { width: 100%; max-width: 640px; margin-inline: auto; filter: drop-shadow(0 20px 50px rgba(0,0,0,.45)); }
  .hero__badge {
    position: absolute; top: 2%; left: -4%; z-index: 2;
    background: linear-gradient(90deg, var(--blue) 0%, #2b6fe6 100%);
    color: #fff; font-weight: 800; text-transform: uppercase;
    font-stretch: 80%; font-variation-settings: 'wdth' 80;
    font-size: 1.15rem; line-height: 1.05; padding: 0.6rem 1rem;
    border-left: 4px solid var(--cyan); max-width: 9.5rem;
    transform: skewX(-6deg);
  }
  .hero__strip {
    position: relative; z-index: 1;
    list-style: none; padding: 1.5rem 0; margin-top: clamp(1rem, 3vw, 2rem);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem;
    border-top: 1px solid rgba(143, 208, 255, .2);
  }
  .hero__strip li { display: flex; gap: 0.85rem; align-items: flex-start; color: var(--cyan); }
  .hero__strip strong { display: block; color: #fff; font-size: 1rem; }
  .hero__strip span { display: block; color: #a9badb; font-size: 0.9rem; line-height: 1.4; margin-top: 0.2rem; }
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__visual { max-width: 30rem; margin-inline: auto; }
    .hero__strip { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .hero__strip { grid-template-columns: 1fr; gap: 1rem; } .hero__badge { font-size: 0.95rem; left: 0; } }

  .why { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .why__claim { font-size: clamp(1.3rem, 2.2vw, 1.6rem); line-height: 1.3; font-weight: 700; text-transform: uppercase; font-stretch: 88%; font-variation-settings: 'wdth' 88; }
  .cmp { list-style: none; padding: 0; margin: 0; border-top: 3px solid var(--ink); }
  .cmp li { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  .cmp__no { color: var(--muted); text-decoration: line-through; text-decoration-color: rgba(77,95,124,.35); }
  .cmp__yes { font-weight: 700; color: var(--blue); }
  @media (max-width: 860px) { .why { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .cmp li { grid-template-columns: 1fr; gap: 0.2rem; } }

  .svc { list-style: none; padding: 0; margin: 2.25rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; background: var(--white); border-radius: var(--radius-m); overflow: hidden; border: 1px solid var(--line); }
  .svc li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .svc li:nth-child(3n) { border-right: 0; }
  .svc li:nth-last-child(-n+3) { border-bottom: 0; }
  .svc a { display: block; padding: 1.9rem; text-decoration: none; height: 100%; transition: background-color .15s ease; }
  .svc a:hover { background: #f6f9ff; color: inherit; }
  .svc__icon { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--blue); color: #fff; margin-bottom: 1.1rem; }
  .svc p { color: var(--muted); margin: 0; font-size: 0.98rem; }
  @media (max-width: 900px) {
    .svc { grid-template-columns: 1fr 1fr; }
    .svc li:nth-child(3n) { border-right: 1px solid var(--line); }
    .svc li:nth-child(2n) { border-right: 0; }
    .svc li:nth-last-child(-n+3) { border-bottom: 1px solid var(--line); }
    .svc li:nth-last-child(-n+2) { border-bottom: 0; }
  }
  @media (max-width: 560px) {
    .svc { grid-template-columns: 1fr; }
    .svc li { border-right: 0 !important; border-bottom: 1px solid var(--line) !important; }
    .svc li:last-child { border-bottom: 0 !important; }
  }

  .support { position: relative; overflow: hidden; background: radial-gradient(90% 120% at 100% 50%, #173d8c 0%, var(--navy) 45%, var(--night) 100%); }
  .support__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: center; }
  .support__rack { justify-self: center; width: 190px; filter: drop-shadow(0 24px 40px rgba(0,0,0,.5)); }
  .steps { list-style: none; counter-reset: s; padding: 0; margin: 2rem 0; display: grid; gap: 1.25rem; }
  .steps li { counter-increment: s; position: relative; padding-left: 3.4rem; }
  .steps li::before { content: counter(s); position: absolute; left: 0; top: 0; width: 2.4rem; height: 2.4rem; border-radius: 50%; display: grid; place-items: center; background: var(--blue); color: #fff; font-weight: 800; box-shadow: 0 0 0 4px rgba(47,139,255,.25); }
  .steps strong { display: block; font-size: 1.08rem; }
  .steps span { color: #b9c7df; }
  @media (max-width: 800px) { .support__grid { grid-template-columns: 1fr; } .support__rack { width: 150px; } }

  .area { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); }
  .area__h { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .sedi { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1rem; }
  .sedi li { padding-left: 1rem; border-left: 3px solid var(--blue); }
  .sedi__tag { font-size: 0.78rem; font-weight: 700; background: var(--blue); color: #fff; padding: 0.1rem 0.5rem; border-radius: 4px; margin-left: 0.5rem; }
  .towns { list-style: none; padding: 0; margin: 0 0 1.25rem; columns: 2; column-gap: 1.5rem; }
  .towns li { padding: 0.3rem 0; break-inside: avoid; }
  @media (max-width: 760px) { .area { grid-template-columns: 1fr; } }
  .more { margin-top: 1.5rem; font-weight: 700; }
</style>
