---
import Base from '../layouts/Base.astro';
import NetworkMap from '../components/NetworkMap.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, SEDI } from '../data/site';
import { SERVIZI } from '../data/servizi';
import { COMUNI } from '../data/comuni';
import { FAQ_GENERALI } from '../data/faq';

const faq = FAQ_GENERALI.slice(0, 5);
const steps = [
  { t: 'Verifica della copertura', d: 'Ci lasci l\'indirizzo della sede. Controlliamo cosa arriva: fibra FTTH, FTTC o radio FWA.' },
  { t: 'Sopralluogo', d: 'Un tecnico G8A guarda armadio di rete, cablaggio e postazioni, e ti propone la soluzione.' },
  { t: 'Passaggio programmato', d: 'Fissiamo la data con te e coordiniamo il cambio con l\'operatore attuale, per non restare senza linea.' },
  { t: 'Assistenza diretta', d: 'Da quel giorno, per qualsiasi problema chiami noi. Ti risponde chi conosce la tua rete.' },
];
const compare = [
  ['Numero verde e operatori a turno', 'Tecnici G8A della tua zona, sempre gli stessi'],
  ['Il guasto è "della rete" o "del tuo router"', 'Seguiamo linea, router e rete interna insieme'],
  ['Il tecnico arriva quando c\'è disponibilità', 'Sedi tra Varese, Milano e Lecco, vicine alle aziende'],
  ['Offerte pensate per le famiglie', 'Solo aziende e partite IVA'],
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'FibraHero by G8A', url: SITE.url, inLanguage: 'it-IT' };
---
<Base
  title="FibraHero by G8A — Fibra per aziende con assistenza diretta"
  description="Fibra FTTH, radio FWA, linea di backup e centralino VoIP per aziende tra Varese, Milano e Lecco. Operatore G8A con tecnici di zona, niente call center."
  jsonLd={[website, faqSchema]}
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__by">Connettività per aziende di G8A Technology</p>
        <h1>Fibra per aziende, con il tecnico che conosci per nome.</h1>
        <p class="hero__lead">Siamo l'operatore e anche l'assistenza. Linea, router e rete interna li segue la stessa squadra, dalle nostre sedi tra Varese, Milano e Lecco.</p>
        <form class="hero__form" action="/verifica-copertura" method="get">
          <label class="visually-hidden" for="h-ind">Indirizzo della sede</label>
          <input id="h-ind" name="indirizzo" placeholder="Indirizzo della tua azienda" autocomplete="street-address" />
          <label class="visually-hidden" for="h-com">Comune</label>
          <input id="h-com" name="comune" placeholder="Comune" autocomplete="address-level2" />
          <button class="btn btn--signal" type="submit">Verifica copertura</button>
        </form>
        <p class="hero__note">Solo per aziende, professionisti e partite IVA.</p>
      </div>
      <div class="hero__map"><NetworkMap /></div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <h2>Quando la linea si ferma, chiami noi</h2>
      <p class="lead">Per un'azienda il problema non è la velocità sulla carta, è sapere chi risolve quando qualcosa non va.</p>
      <div class="cmp" role="table" aria-label="Confronto tra un grande operatore e FibraHero">
        <div class="cmp__head" role="row">
          <span role="columnheader">Con un grande operatore</span>
          <span role="columnheader">Con FibraHero</span>
        </div>
        {compare.map(([a, b]) => (
          <div class="cmp__row" role="row">
            <span role="cell">{a}</span>
            <span role="cell">{b}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Cosa possiamo collegare</h2>
      <ul class="svc">
        {SERVIZI.map((s) => (
          <li>
            <a href={`/${s.slug}`}>
              <h3>{s.name}</h3>
              <p>{s.short}</p>
              <span class="svc__more">Scopri {s.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <h2>Come si passa a FibraHero</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="steps__n" aria-hidden="true">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap area">
      <div>
        <h2>Dove siamo</h2>
        <p class="lead">Le aziende che seguiamo sono a portata di una delle nostre sedi. Per questo un intervento in sede non diventa un'attesa di giorni.</p>
        <ul class="sedi">
          {SEDI.map((s) => (
            <li><strong>{s.city}</strong>{s.operativa && <span class="sedi__tag">sede operativa</span>}<br />{s.address}, {s.cap} ({s.province})</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="area__h">Fibra aziendale per comune</h2>
        <ul class="towns">
          {COMUNI.map((c) => <li><a href={`/fibra-aziendale/${c.slug}`}>{c.name}</a></li>)}
        </ul>
        <p><a href="/fibra-aziendale">Tutte le zone servite</a></p>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="wrap">
      <Faq items={faq} />
      <p class="more"><a href="/domande-frequenti">Altre domande</a></p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { background: var(--ink); color: #fff; padding-block: clamp(3rem, 7vw, 5.5rem); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero__by { color: var(--fiber-soft); font-weight: 600; margin-bottom: 1rem; }
  .hero__lead { font-size: 1.2rem; color: #c9d5e3; max-width: 46ch; }
  .hero__form { display: grid; grid-template-columns: 1.6fr 1fr auto; gap: 0.5rem; margin-top: 2rem; background: var(--ink-2); padding: 0.5rem; border-radius: var(--radius-m); }
  .hero__form input { font: inherit; min-height: 3rem; padding: 0.6rem 0.9rem; border: 0; border-radius: var(--radius-s); background: #fff; color: var(--ink); min-width: 0; }
  .hero__form input:focus-visible { outline: 3px solid var(--fiber); }
  .hero__note { font-size: 0.9rem; color: #9fb0c4; margin-top: 0.8rem; }
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__map { max-width: 34rem; }
  }
  @media (max-width: 560px) { .hero__form { grid-template-columns: 1fr; } }

  .cmp { margin-top: 2rem; border-top: 2px solid var(--ink); max-width: 56rem; }
  .cmp__head, .cmp__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .cmp__head { font-weight: 800; font-stretch: 112%; font-variation-settings: 'wdth' 112; }
  .cmp__head span:last-child { color: var(--fiber); }
  .cmp__row span:first-child { color: var(--muted); text-decoration: line-through; text-decoration-color: rgba(86,103,125,.35); }
  .cmp__row span:last-child { font-weight: 600; }
  @media (max-width: 560px) { .cmp__head, .cmp__row { gap: 1rem; font-size: 0.95rem; } }

  .svc { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(2, 1fr); border-top: 2px solid var(--ink); }
  .svc li { border-bottom: 1px solid var(--line); }
  .svc li:nth-child(odd) { border-right: 1px solid var(--line); }
  .svc a { display: block; padding: 1.75rem 1.75rem 1.75rem 0; text-decoration: none; height: 100%; }
  .svc li:nth-child(even) a { padding-left: 1.75rem; }
  .svc a:hover h3 { color: var(--fiber); }
  .svc a:hover { color: inherit; }
  .svc p { color: var(--muted); margin-bottom: 0.75rem; }
  .svc__more { font-weight: 700; text-decoration: underline; text-decoration-color: var(--fiber); text-underline-offset: 0.25em; text-decoration-thickness: 2px; }
  @media (max-width: 700px) {
    .svc { grid-template-columns: 1fr; }
    .svc li:nth-child(odd) { border-right: 0; }
    .svc li:nth-child(even) a { padding-left: 0; }
  }

  .steps { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; position: relative; }
  .steps::before { content: ''; position: absolute; top: 1.25rem; left: 1.25rem; right: 1.25rem; height: 3px; background: linear-gradient(90deg, var(--fiber), var(--fiber-soft)); z-index: 0; }
  .steps li { position: relative; z-index: 1; }
  .steps__n { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: var(--ink); color: #fff; font-weight: 800; margin-bottom: 1.2rem; box-shadow: 0 0 0 6px var(--white); }
  .steps p { color: var(--muted); }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; gap: 1.5rem; }
    .steps::before { top: 1.25rem; bottom: 1.25rem; left: 1.2rem; right: auto; width: 3px; height: auto; }
    .steps li { padding-left: 3.75rem; }
    .steps__n { position: absolute; left: 0; top: 0; }
  }

  .area { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); }
  .area__h { font-size: 1.5rem; }
  .sedi { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1rem; }
  .sedi li { padding-left: 1rem; border-left: 3px solid var(--fiber); }
  .sedi__tag { font-size: 0.8rem; font-weight: 700; background: var(--signal); color: var(--signal-ink); padding: 0.1rem 0.45rem; border-radius: 4px; margin-left: 0.5rem; }
  .towns { list-style: none; padding: 0; margin: 0 0 1.25rem; columns: 2; column-gap: 1.5rem; }
  .towns li { padding: 0.3rem 0; break-inside: avoid; }
  @media (max-width: 760px) { .area { grid-template-columns: 1fr; } }
  .more { margin-top: 1.5rem; font-weight: 700; }
</style>
