---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import LightStreaks from '../components/LightStreaks.astro';
import CtaBand from '../components/CtaBand.astro';
import { SERVIZI, type Servizio } from '../data/servizi';
import { SITE, waLink } from '../data/site';

export function getStaticPaths() {
  return SERVIZI.map((s) => ({ params: { servizio: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Servizio };
const others = SERVIZI.filter((o) => o.slug !== s.slug);
const wa = `Ciao FibraHero, vorrei informazioni su: ${s.name}.`;

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  serviceType: s.name,
  description: s.description,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: ['Provincia di Varese', 'Città metropolitana di Milano', 'Provincia di Lecco'],
  audience: { '@type': 'BusinessAudience', audienceType: 'Aziende e partite IVA' },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base title={s.title} description={s.description} jsonLd={[service, faqSchema]}>
  <section class="pagehead">
    <LightStreaks />
    <div class="wrap sv">
      <div>
        <Breadcrumbs items={[{ name: 'Servizi', href: '/servizi' }, { name: s.name, href: `/${s.slug}` }]} />
        <span class="sv__icon"><Icon name={s.icon} size={34} /></span>
        <h1>{s.title}</h1>
        <p class="lead">{s.intro}</p>
        <a class="btn btn--wa" href={waLink(wa)} target="_blank" rel="noopener"><Icon name="whatsapp" size={22} /> Chiedi un'offerta su WhatsApp</a>
      </div>
      <aside class="sv__box">
        <h2 class="sv__h">Cosa include</h2>
        <ul class="ticks">{s.includes.map((i) => <li>{i}</li>)}</ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="wrap sv__two">
      <div>
        <h2>Per chi è</h2>
        <hr class="rule" />
        <ul class="ticks">{s.forWho.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div>
        <h2>Assistenza diretta</h2>
        <hr class="rule" />
        <p>Il servizio è seguito dai tecnici G8A dalle sedi di Solbiate Arno, Gallarate, Busto Arsizio, Jerago con Orago, Bollate e Lecco. Nessun call center: scrivi al {SITE.phone}, verifichiamo da remoto e, se serve, veniamo in sede.</p>
        <p><a href="/chi-siamo">Chi c'è dietro FibraHero</a></p>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap"><Faq items={s.faq} /></div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Gli altri servizi</h2>
      <ul class="others">
        {others.map((o) => (
          <li>
            <a href={`/${o.slug}`}><span class="others__icon"><Icon name={o.icon} size={24} /></span><strong>{o.name}</strong></a>
            <span>{o.short}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand waText={wa} />
</Base>

<style>
  .sv { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .sv__icon { display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 50%; background: var(--blue); color: #fff; margin-bottom: 1.25rem; box-shadow: 0 0 0 6px rgba(47,139,255,.2), 0 0 40px rgba(47,139,255,.5); }
  .sv h1 { font-size: clamp(2.4rem, 5vw, 4rem); }
  .sv__box { background: #fff; color: var(--ink); padding: 1.9rem; border-radius: var(--radius-m); border-top: 5px solid var(--blue); }
  .sv__h { font-size: 1.6rem; }
  .sv__two { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); }
  .others { list-style: none; padding: 0; margin: 1.5rem 0 0; border-top: 3px solid var(--ink); }
  .others li { display: grid; grid-template-columns: 17rem 1fr; gap: 1rem; align-items: center; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .others a { display: inline-flex; gap: 0.75rem; align-items: center; text-decoration: none; }
  .others__icon { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--blue); color: #fff; flex: none; }
  .others li > span { color: var(--muted); }
  @media (max-width: 800px) {
    .sv, .sv__two { grid-template-columns: 1fr; }
    .others li { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
