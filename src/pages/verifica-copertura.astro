---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CoverageForm from '../components/CoverageForm.astro';
import { SITE } from '../data/site';
---
<Base
  title="Verifica copertura fibra per la tua azienda"
  description="Verifica se all'indirizzo della tua azienda arriva la fibra FTTH, FTTC o la connessione radio FWA. Ti richiama un tecnico G8A della tua zona."
>
  <section class="section section--white">
    <div class="wrap vc">
      <div>
        <Breadcrumbs items={[{ name: 'Verifica copertura', href: '/verifica-copertura' }]} />
        <h1>Verifica la copertura della tua sede</h1>
        <p class="lead">Controlliamo cosa arriva all'indirizzo e ti richiamiamo con la soluzione adatta. Nessun impegno.</p>
        <ul class="ticks">
          <li>Verifica di fibra FTTH, FTTC e radio FWA</li>
          <li>Risposta da un tecnico G8A, non da un call center</li>
          <li>Servizio riservato ad aziende e partite IVA</li>
        </ul>
        <p class="vc__alt">Preferisci scrivere? <a href={`mailto:${SITE.email}`}>{SITE.email}</a>{SITE.phone && <> oppure chiama il <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></>}</p>
      </div>
      <div class="vc__form"><CoverageForm /></div>
    </div>
  </section>
</Base>

<style>
  .vc { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .vc__form { background: var(--paper); padding: clamp(1.25rem, 3vw, 2.25rem); border-radius: var(--radius-m); border-top: 4px solid var(--fiber); }
  .vc__alt { margin-top: 2rem; color: var(--muted); }
  @media (max-width: 860px) { .vc { grid-template-columns: 1fr; } }
</style>
