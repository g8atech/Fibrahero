---
// Guide FibraHero scritte con Nina in Brain e firmate dalla direzione (Marketing → Guide).
// I dati arrivano in src/data/guideNina.ts dal workflow "Guide di Nina" (ogni ora, solo guide firmate).
// Senza guide non si genera nessuna pagina: niente /guide vuota su Google.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import FiberCanvas from '../../components/FiberCanvas.astro';
import CtaBand from '../../components/CtaBand.astro';
import { GUIDE_NINA } from '../../data/guideNina';
import { SITE } from '../../data/site';

type Img = { url: string; alt: string; didascalia?: string };
type Sezione = { titolo: string; paragrafi?: string[]; punti?: string[]; immagine?: Img | null };
type Guida = {
  slug: string; titolo: string; h1: string; descrizione: string; intro: string; in_breve: string[];
  sezioni: Sezione[]; faq: { d: string; r: string }[]; link: { testo: string; url: string }[];
  firmato_da: string | null; pubblicata_il: string; aggiornata_il: string; copertina?: Img | null;
};

export function getStaticPaths() {
  const guide = (GUIDE_NINA as Guida[]).filter((g) => g.slug && g.firmato_da);
  if (!guide.length) return [];
  return [{ params: { slug: undefined }, props: { guida: null, guide } }, ...guide.map((g) => ({ params: { slug: g.slug }, props: { guida: g, guide } }))];
}

const { guida, guide } = Astro.props as { guida: Guida | null; guide: Guida[] };
const BASE = SITE.url;
const RUOLI: Record<string, string> = { 'Giuseppe Arrigo': 'co-fondatore di G8A Technology', 'Antonio Arrigo': 'co-fondatore di G8A Technology' };
const data = (iso: string) => new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Rome' }).format(new Date(`${iso}T12:00:00Z`));
const path = guida ? `/guide/${guida.slug}` : '/guide';
const wa = guida ? `Ciao FibraHero, ho letto la guida "${guida.h1}" e vorrei un consiglio per la connessione della mia azienda.` : undefined;
const crumbs = [{ name: 'Guide', href: '/guide' }, ...(guida ? [{ name: guida.h1, href: path }] : [])];
const faqLd = (g: Guida) => ({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: g.faq.map((f) => ({ '@type': 'Question', name: f.d, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
});
const jsonLd = guida
  ? [
      {
        '@context': 'https://schema.org', '@type': 'Article', headline: guida.h1, ...(guida.copertina?.url ? { image: guida.copertina.url } : {}), description: guida.descrizione, inLanguage: 'it-IT',
        datePublished: guida.pubblicata_il, dateModified: guida.aggiornata_il, mainEntityOfPage: `${BASE}${path}`,
        author: { '@id': `${BASE}/#organization` }, publisher: { '@id': `${BASE}/#organization` },
      },
      {
        '@context': 'https://schema.org', '@type': 'WebPage', url: `${BASE}${path}`, name: guida.titolo, lastReviewed: guida.aggiornata_il,
        ...(guida.firmato_da ? { reviewedBy: { '@type': 'Person', name: guida.firmato_da, ...(RUOLI[guida.firmato_da] ? { jobTitle: RUOLI[guida.firmato_da] } : {}) } } : {}),
      },
      ...(guida.faq.length ? [faqLd(guida)] : []),
    ]
  : [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Guide FibraHero sulla connessione aziendale', url: `${BASE}/guide`, hasPart: guide.map((g) => ({ '@type': 'Article', headline: g.h1, url: `${BASE}/guide/${g.slug}` })) }];
const altre = guida ? guide.filter((g) => g.slug !== guida.slug).slice(0, 4) : guide;
---
<Base
  title={guida ? guida.titolo : 'Guide sulla connessione per aziende'}
  description={guida ? guida.descrizione : 'Guide pratiche FibraHero per le aziende: fibra FTTH e FTTC, rete e Wi-Fi dell\'ufficio, firewall, backup della connessione e centralino cloud spiegati in modo semplice.'}
  jsonLd={jsonLd}
>
  <section class="pagehead">
    <FiberCanvas />
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      {guida ? <h1>{guida.h1}</h1> : <h1>Guide sulla connessione per aziende</h1>}
      <p class="lead">{guida ? guida.intro : 'Fibra, rete dell\'ufficio, firewall, backup e centralino spiegati senza gergo: cosa conviene fare in pratica in un ufficio o in una PMI.'}</p>
    </div>
  </section>

  {guida && (
    <section class="section">
      <div class="wrap guida">
        <p class="byline">Guida FibraHero by G8A{guida.firmato_da ? <> · verificata da <b>{guida.firmato_da}</b>{RUOLI[guida.firmato_da] ? `, ${RUOLI[guida.firmato_da]}` : ''}</> : null} · aggiornata il {data(guida.aggiornata_il)}</p>
        {guida.copertina?.url && <img class="cover" src={guida.copertina.url} alt={guida.copertina.alt} width="1200" height="800" />}
        {guida.in_breve.length > 0 && (
          <aside class="breve" aria-label="In breve"><b>In breve</b><ul>{guida.in_breve.map((b) => <li>{b}</li>)}</ul></aside>
        )}
        {guida.sezioni.map((s) => (
          <section>
            <h2>{s.titolo}</h2>
            {(s.paragrafi ?? []).map((p) => <p>{p}</p>)}
            {(s.punti ?? []).length > 0 && <ul class="punti">{s.punti!.map((p) => <li>{p}</li>)}</ul>}
            {s.immagine?.url && <figure><img src={s.immagine.url} alt={s.immagine.alt} width="1200" height="800" loading="lazy" />{s.immagine.didascalia && <figcaption>{s.immagine.didascalia}</figcaption>}</figure>}
          </section>
        ))}
        {guida.link.length > 0 && (
          <nav class="approf" aria-label="Per approfondire"><h2>Per approfondire</h2><ul>{guida.link.map((l) => <li><a href={l.url}>{l.testo}</a></li>)}</ul></nav>
        )}
        {guida.faq.length > 0 && <div class="faqbox"><Faq items={guida.faq.map((f) => ({ q: f.d, a: f.r }))} /></div>}
      </div>
    </section>
  )}

  {altre.length > 0 && (
    <section class={guida ? 'section section--paper' : 'section'}>
      <div class="wrap">
        {guida && <h2 class="altre">Leggi anche</h2>}
        <ul class="glist">{altre.map((g) => <li><a href={`/guide/${g.slug}`}>{g.copertina?.url && <img src={g.copertina.url} alt="" width="1200" height="800" loading="lazy" />}<b>{g.h1}</b><span>{g.descrizione}</span></a></li>)}</ul>
      </div>
    </section>
  )}

  <CtaBand waText={wa} />
</Base>

<style>
  .guida { max-width: 50rem; }
  .byline { font-size: .92rem; color: var(--muted); margin: 0 0 1.4rem; }
  .cover { width: 100%; height: auto; border-radius: var(--radius-m); margin: 0 0 1.5rem; }
  figure { margin: 1.1rem 0 0; }
  figure img { width: 100%; height: auto; border-radius: var(--radius-m); }
  figcaption { font-size: .88rem; color: var(--muted); margin-top: .4rem; }
  .guida section + section, .breve + section { margin-top: 2rem; }
  .guida h2 { font-size: clamp(1.4rem, 2.6vw, 1.8rem); font-weight: 800; letter-spacing: -.02em; line-height: 1.15; margin: 0 0 .8rem; }
  .guida p { margin: 0 0 .8rem; line-height: 1.65; }
  .punti { padding-left: 1.3rem; margin: 0; }
  .punti li { margin-bottom: .4rem; line-height: 1.6; }
  .breve { border-left: 4px solid var(--blue); background: var(--paper); border-radius: var(--radius-m); padding: 1rem 1.2rem; }
  .breve b { display: block; margin-bottom: .4rem; }
  .breve ul { padding-left: 1.2rem; margin: 0; }
  .approf { margin-top: 2rem; }
  .approf ul { padding-left: 1.3rem; }
  .approf a { color: var(--blue); text-decoration: underline; }
  .faqbox { margin-top: 2.5rem; }
  .altre { font-size: clamp(1.4rem, 2.6vw, 1.8rem); font-weight: 800; margin: 0 0 1.4rem; }
  .glist { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .glist a { display: flex; flex-direction: column; gap: .4rem; height: 100%; padding: 1.2rem; border: 1px solid var(--line); border-top: 4px solid var(--blue); border-radius: var(--radius-m); background: #fff; color: inherit; text-decoration: none; overflow: hidden; }
  .glist a:hover { border-color: var(--blue); }
  .glist img { width: calc(100% + 2.4rem); max-width: none; height: auto; aspect-ratio: 3/2; object-fit: cover; margin: -1.2rem -1.2rem .4rem; }
  .glist span { font-size: .93rem; color: var(--muted); }
</style>
