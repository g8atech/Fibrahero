---
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/servizi', label: 'Servizi' },
  { href: '/fibra-aziendale', label: 'Zone' },
  { href: '/chi-siamo', label: 'Chi siamo' },
  { href: '/domande-frequenti', label: 'Domande' },
];
---
<header class="hdr">
  <div class="wrap hdr__row">
    <a href="/" class="hdr__home" aria-label="FibraHero, pagina iniziale"><Logo /></a>
    <nav aria-label="Principale">
      <ul class="hdr__nav">
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="/verifica-copertura" class="btn btn--signal hdr__cta">Verifica copertura</a>
  </div>
</header>

<style>
  .hdr { background: var(--white); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
  .hdr__row { display: flex; align-items: center; gap: 1.5rem; min-height: 4.25rem; }
  .hdr__home { text-decoration: none; color: var(--ink); }
  .hdr__home:hover { color: var(--ink); }
  nav { margin-left: auto; }
  .hdr__nav { display: flex; gap: 1.6rem; list-style: none; margin: 0; padding: 0; font-weight: 600; font-size: 0.98rem; }
  .hdr__nav a { text-decoration: none; padding-block: 0.4rem; }
  .hdr__nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--fiber); }
  .hdr__cta { min-height: 2.6rem; padding: 0.5rem 1rem; font-size: 0.95rem; }
  @media (max-width: 860px) {
    .hdr__row { flex-wrap: wrap; gap: 0.5rem 1rem; padding-block: 0.6rem; }
    nav { order: 3; width: 100%; margin: 0; overflow-x: auto; }
    .hdr__nav { gap: 1.2rem; }
    .hdr__cta { margin-left: auto; }
  }
  @media (max-width: 420px) { .hdr__cta { padding-inline: 0.75rem; font-size: 0.88rem; } }
</style>
