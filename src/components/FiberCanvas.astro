---
// Fascio di fibre ottiche (canvas): decine di fibre arrivano da sinistra, si stringono
// in un fascio dietro al supereroe e si riaprono a destra. Impulsi di luce le percorrono.
// All'avvio parte un'onda di luce su tutte le fibre insieme. Il fascio segue il mouse.
// Si ferma fuori schermo; con "riduci movimento" disegna un solo fotogramma.
---
<canvas class="fiber" aria-hidden="true"></canvas>

<style>
  .fiber { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  /* Sotto ai testi le fibre restano tenui, così il titolo si legge sempre */
  @media (min-width: 901px) {
    .fiber { -webkit-mask-image: linear-gradient(90deg, rgba(0,0,0,.28) 0%, rgba(0,0,0,.32) 40%, #000 62%); mask-image: linear-gradient(90deg, rgba(0,0,0,.28) 0%, rgba(0,0,0,.32) 40%, #000 62%); }
  }
  @media (max-width: 900px) {
    .fiber { -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,.3) 0%, rgba(0,0,0,.35) 50%, #000 70%); mask-image: linear-gradient(180deg, rgba(0,0,0,.3) 0%, rgba(0,0,0,.35) 50%, #000 70%); }
  }
</style>

<script>
  type Fiber = { y0: number; y1: number; hue: number; w: number; a: number; ph: number; sp: number };
  type Pulse = { f: number; t: number; v: number; len: number; hot: boolean };

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const N = 64; // punti per fibra

  document.querySelectorAll<HTMLCanvasElement>('canvas.fiber').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    if (!ctx || !host) return;

    let W = 0, H = 0, dpr = 1, mobile = false;
    let fibers: Fiber[] = [];
    let pulses: Pulse[] = [];
    const pts: Float32Array[] = [];
    // Punto di stretta del fascio (dietro al supereroe) e sua posizione "seguita".
    const focus = { x: 0.72, y: 0.46 };
    const target = { x: 0.72, y: 0.46 };
    let running = false, raf = 0, last = 0, clock = 0;

    function setup() {
      const r = host!.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = r.width; H = r.height;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      mobile = W < 900;
      const base = mobile ? { x: 0.5, y: 0.66 } : { x: 0.72, y: 0.44 };
      focus.x = target.x = base.x; focus.y = target.y = base.y;
      const count = mobile ? 22 : 40;
      fibers = Array.from({ length: count }, (_, i) => {
        const k = i / (count - 1);
        return {
          y0: -0.15 + k * 1.3 + (Math.random() - 0.5) * 0.06,
          y1: -0.2 + Math.random() * 1.4,
          hue: Math.random() < 0.18 ? 190 : 214 + Math.random() * 10,
          w: 0.6 + Math.random() * 1.1,
          a: 0.07 + Math.random() * 0.12,
          ph: Math.random() * Math.PI * 2,
          sp: 0.4 + Math.random() * 0.6,
        };
      });
      pts.length = 0;
      for (let i = 0; i < count; i++) pts.push(new Float32Array(N * 2));
      // Onda di accensione: un impulso per fibra, tutti insieme da sinistra.
      pulses = fibers.map((_, f) => ({ f, t: -0.05 - Math.random() * 0.12, v: 0.55 + Math.random() * 0.15, len: 0.16, hot: true }));
    }

    // Curva di una fibra: sinistra → stretta (focus) → destra, con una leggera ondulazione.
    function computePaths() {
      const fx = focus.x * W, fy = focus.y * H;
      fibers.forEach((fb, i) => {
        const p = pts[i];
        const wob = Math.sin(clock * fb.sp + fb.ph) * H * 0.025;
        const x0 = -W * 0.05, y0 = fb.y0 * H + wob;
        const x3 = W * 1.05, y3 = fb.y1 * H - wob;
        const spread = (fb.y0 - 0.5) * H * 0.06; // il fascio non è un punto: resta un po' spesso
        for (let n = 0; n < N; n++) {
          const t = n / (N - 1);
          let x: number, y: number;
          if (t < 0.5) {
            const u = t / 0.5, e = u * u * (3 - 2 * u);
            x = x0 + (fx - x0) * u;
            y = y0 + (fy + spread - y0) * e;
          } else {
            const u = (t - 0.5) / 0.5, e = u * u * (3 - 2 * u);
            x = fx + (x3 - fx) * u;
            y = fy + spread + (y3 - fy - spread) * e;
          }
          p[n * 2] = x; p[n * 2 + 1] = y;
        }
      });
    }

    function at(p: Float32Array, t: number) {
      const f = Math.max(0, Math.min(1, t)) * (N - 1);
      const i = Math.min(N - 2, Math.floor(f)), r = f - i;
      return [p[i * 2] + (p[i * 2 + 2] - p[i * 2]) * r, p[i * 2 + 1] + (p[i * 2 + 3] - p[i * 2 + 1]) * r];
    }

    function draw() {
      ctx!.clearRect(0, 0, W, H);
      ctx!.globalCompositeOperation = 'lighter';
      ctx!.lineCap = 'round';
      // Fibre a riposo
      fibers.forEach((fb, i) => {
        const p = pts[i];
        ctx!.beginPath();
        ctx!.moveTo(p[0], p[1]);
        for (let n = 1; n < N; n++) ctx!.lineTo(p[n * 2], p[n * 2 + 1]);
        ctx!.strokeStyle = `hsla(${fb.hue}, 100%, 62%, ${fb.a})`;
        ctx!.lineWidth = fb.w;
        ctx!.stroke();
      });
      // Bagliore nel punto di stretta
      const fx = focus.x * W, fy = focus.y * H;
      const g = ctx!.createRadialGradient(fx, fy, 0, fx, fy, Math.min(W, H) * 0.35);
      g.addColorStop(0, 'rgba(111,214,255,0.22)');
      g.addColorStop(1, 'rgba(47,139,255,0)');
      ctx!.fillStyle = g;
      ctx!.fillRect(0, 0, W, H);
      // Impulsi: una scia che sfuma, disegnata in più passate per l'effetto luce
      for (const pu of pulses) {
        if (pu.t <= 0 || pu.t - pu.len >= 1) continue;
        const p = pts[pu.f], fb = fibers[pu.f];
        const steps = 14;
        for (let s = 0; s < steps; s++) {
          const t0 = pu.t - (pu.len * (s + 1)) / steps, t1 = pu.t - (pu.len * s) / steps;
          if (t1 < 0 || t0 > 1) continue;
          const [ax, ay] = at(p, t0), [bx, by] = at(p, t1);
          const k = 1 - s / steps;
          ctx!.beginPath(); ctx!.moveTo(ax, ay); ctx!.lineTo(bx, by);
          ctx!.strokeStyle = `hsla(${fb.hue - 10}, 100%, ${70 + 25 * k}%, ${0.12 * k})`;
          ctx!.lineWidth = fb.w + 7 * k; ctx!.stroke();
          ctx!.strokeStyle = `hsla(${fb.hue - 10}, 100%, ${75 + 25 * k}%, ${(pu.hot ? 0.95 : 0.75) * k})`;
          ctx!.lineWidth = fb.w + 0.8 * k; ctx!.stroke();
        }
        // Testa luminosa
        const [hx, hy] = at(p, pu.t);
        const hg = ctx!.createRadialGradient(hx, hy, 0, hx, hy, 9);
        hg.addColorStop(0, 'rgba(255,255,255,0.9)'); hg.addColorStop(1, 'rgba(111,214,255,0)');
        ctx!.fillStyle = hg; ctx!.fillRect(hx - 9, hy - 9, 18, 18);
      }
      ctx!.globalCompositeOperation = 'source-over';
    }

    function tick(now: number) {
      const dt = Math.min(0.05, (now - (last || now)) / 1000);
      last = now; clock += dt;
      focus.x += (target.x - focus.x) * 0.04;
      focus.y += (target.y - focus.y) * 0.04;
      for (const pu of pulses) pu.t += pu.v * dt;
      pulses = pulses.filter((pu) => pu.t - pu.len < 1);
      const max = mobile ? 9 : 18;
      while (pulses.length < max) {
        pulses.push({ f: Math.floor(Math.random() * fibers.length), t: 0, v: 0.18 + Math.random() * 0.35, len: 0.06 + Math.random() * 0.1, hot: false });
      }
      computePaths(); draw();
      raf = requestAnimationFrame(tick);
    }

    function start() { if (!running && !reduce) { running = true; last = 0; raf = requestAnimationFrame(tick); } }
    function stop() { running = false; cancelAnimationFrame(raf); }

    setup(); computePaths();
    if (reduce) { pulses = fibers.slice(0, 10).map((_, f) => ({ f: f * 3 % fibers.length, t: 0.3 + Math.random() * 0.5, v: 0, len: 0.12, hot: false })); draw(); }

    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(canvas);
    let rt = 0;
    new ResizeObserver(() => { clearTimeout(rt); rt = window.setTimeout(() => { setup(); computePaths(); if (reduce) draw(); }, 120); }).observe(host);
    host.addEventListener('pointermove', (e) => {
      if (mobile) return;
      const r = host.getBoundingClientRect();
      target.x = 0.72 + ((e.clientX - r.left) / r.width - 0.5) * 0.12;
      target.y = 0.44 + ((e.clientY - r.top) / r.height - 0.5) * 0.2;
    });
    host.addEventListener('pointerleave', () => { if (!mobile) { target.x = 0.72; target.y = 0.44; } });
  });
</script>
