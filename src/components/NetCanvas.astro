---
// Rete di nodi animata (canvas): punti luminosi collegati che si muovono
// e reagiscono al mouse. Si ferma fuori schermo e con "riduci movimento".
interface Props { density?: number }
const { density = 0.00009 } = Astro.props;
---
<canvas class="net" data-density={density} aria-hidden="true"></canvas>

<style>
  .net { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: .9; }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLCanvasElement>('canvas.net').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const density = Number(canvas.dataset.density) || 0.00009;
    let w = 0, h = 0, dpr = 1, raf = 0, visible = true;
    const mouse = { x: -9999, y: -9999 };
    type P = { x: number; y: number; vx: number; vy: number; r: number };
    let pts: P[] = [];
    // "Pacchetti" che viaggiano lungo i collegamenti
    type Pk = { a: number; b: number; t: number; s: number };
    let packets: Pk[] = [];

    function resize() {
      const r = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = r.width; h = r.height;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.max(24, Math.min(110, Math.round(w * h * density)));
      pts = Array.from({ length: n }, () => ({
        x: Math.random() * w, y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 1.6 + 0.6,
      }));
      packets = [];
    }

    const LINK = 130;
    function frame() {
      ctx!.clearRect(0, 0, w, h);
      for (const p of pts) {
        if (!reduce) { p.x += p.vx; p.y += p.vy; }
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
        const dx = p.x - mouse.x, dy = p.y - mouse.y, d = Math.hypot(dx, dy);
        if (d < 120 && !reduce) { p.x += dx / d * 0.8; p.y += dy / d * 0.8; }
      }
      for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
          const a = pts[i], b = pts[j];
          const d = Math.hypot(a.x - b.x, a.y - b.y);
          if (d < LINK) {
            ctx!.strokeStyle = `rgba(111,214,255,${(1 - d / LINK) * 0.28})`;
            ctx!.lineWidth = 1;
            ctx!.beginPath(); ctx!.moveTo(a.x, a.y); ctx!.lineTo(b.x, b.y); ctx!.stroke();
            if (!reduce && packets.length < 14 && Math.random() < 0.0009) packets.push({ a: i, b: j, t: 0, s: 0.012 + Math.random() * 0.02 });
          }
        }
      }
      for (const p of pts) {
        ctx!.fillStyle = 'rgba(191,234,255,.85)';
        ctx!.beginPath(); ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx!.fill();
      }
      packets = packets.filter((k) => k.t <= 1);
      for (const k of packets) {
        const a = pts[k.a], b = pts[k.b];
        if (!a || !b) { k.t = 2; continue; }
        k.t += k.s;
        const x = a.x + (b.x - a.x) * k.t, y = a.y + (b.y - a.y) * k.t;
        const g = ctx!.createRadialGradient(x, y, 0, x, y, 8);
        g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(.4, 'rgba(47,139,255,.8)'); g.addColorStop(1, 'rgba(47,139,255,0)');
        ctx!.fillStyle = g; ctx!.beginPath(); ctx!.arc(x, y, 8, 0, Math.PI * 2); ctx!.fill();
      }
      if (!reduce && visible) raf = requestAnimationFrame(frame);
    }

    resize();
    frame();
    window.addEventListener('resize', () => { resize(); if (reduce) frame(); });
    const host = canvas.parentElement!;
    host.addEventListener('pointermove', (e) => { const r = canvas.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; });
    host.addEventListener('pointerleave', () => { mouse.x = mouse.y = -9999; });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      cancelAnimationFrame(raf);
      if (visible && !reduce) raf = requestAnimationFrame(frame);
    }).observe(canvas);
  });
</script>
