---
interface Props { items: string[] }
const { items } = Astro.props;
const loop = [...items, ...items];
---
<div class="tk" aria-hidden="true">
  <div class="tk__track">
    {loop.map((i) => <span>{i}</span>)}
  </div>
</div>

<style>
  .tk { overflow: hidden; background: linear-gradient(90deg, var(--blue-dark), var(--blue), var(--blue-dark)); color: #fff; padding-block: 0.85rem; border-block: 1px solid rgba(143,208,255,.35); }
  .tk__track { display: flex; width: max-content; animation: tk 38s linear infinite; }
  .tk span {
    display: inline-flex; align-items: center; gap: 2.25rem; padding-right: 2.25rem;
    font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap;
    font-stretch: 85%; font-variation-settings: 'wdth' 85; font-size: 1.05rem;
  }
  .tk span::after { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 10px var(--cyan); }
  @keyframes tk { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .tk__track { animation: none; } }
</style>
