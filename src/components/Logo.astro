---
import { Image } from 'astro:assets';
import logoDark from '../assets/logo-h.png';
import logoLight from '../assets/logo-h-white.png';
interface Props { tone?: 'onDark' | 'onLight'; width?: number }
const { tone = 'onDark', width = 190 } = Astro.props;
---
<Image
  src={tone === 'onDark' ? logoLight : logoDark}
  alt="FibraHero"
  width={width}
  densities={[1, 2]}
  loading="eager"
  class="logo"
/>
