---
interface Props { tone?: 'light' | 'dark' }
const { tone = 'dark' } = Astro.props;
---
<span class={`logo logo--${tone}`}>
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
    <rect width="32" height="32" rx="7" fill="currentColor" class="logo__tile" />
    <path d="M6 22c5 0 6-12 11-12s5 8 9 8" fill="none" stroke="#12a4b6" stroke-width="3" stroke-linecap="round" />
    <circle cx="26" cy="18" r="2.6" fill="#f5b53d" />
  </svg>
  <span class="logo__word">Fibra<b>Hero</b></span>
  <span class="logo__by">by G8A</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; font-stretch: 125%; font-variation-settings: 'wdth' 125; }
  .logo__word { font-weight: 600; font-size: 1.2rem; letter-spacing: -0.01em; }
  .logo__word b { font-weight: 800; }
  .logo__by { font-size: 0.75rem; font-weight: 600; opacity: 0.65; font-stretch: 100%; font-variation-settings: 'wdth' 100; align-self: flex-end; margin-bottom: 0.2rem; }
  @media (max-width: 420px) { .logo--dark .logo__by { display: none; } }
  .logo--dark .logo__tile { color: #0f2340; }
  .logo--light .logo__tile { color: #1b3358; }
</style>
