---
// Numeri del gruppo che si "contano" quando entrano nello schermo.
interface Props { items: { n: number; prefix?: string; suffix?: string; label: string }[]; tone?: 'dark' | 'light' }
const { items, tone = 'dark' } = Astro.props;
---
<ul class={`st st--${tone}`}>
  {items.map((i) => (
    <li>
      <span class="st__n">{i.prefix}<span data-count={i.n}>{i.n}</span>{i.suffix}</span>
      <span class="st__l">{i.label}</span>
    </li>
  ))}
</ul>

<style>
  .st { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .st li { padding: 1.25rem 0 0; border-top: 2px solid var(--electric); }
  .st__n {
    display: block; font-weight: 800; line-height: 1; font-size: clamp(2.8rem, 6vw, 4.4rem);
    font-stretch: 78%; font-variation-settings: 'wdth' 78; font-variant-numeric: tabular-nums;
  }
  .st--dark .st__n { background: linear-gradient(180deg, #fff, #8fd0ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .st--light .st__n { color: var(--blue); }
  .st__l { display: block; margin-top: 0.5rem; font-weight: 600; }
  .st--dark .st__l { color: #b9c7df; }
  .st--light .st__l { color: var(--muted); }
  @media (max-width: 760px) { .st { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce) {
    els.forEach((el) => (el.textContent = '0'));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        io.unobserve(el);
        const end = Number(el.dataset.count);
        const t0 = performance.now(), dur = 1400;
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
    }, { threshold: 0.4 });
    els.forEach((el) => io.observe(el));
  }
</script>
