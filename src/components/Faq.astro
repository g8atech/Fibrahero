---
interface Props { items: { q: string; a: string }[]; heading?: string }
const { items, heading = 'Domande frequenti' } = Astro.props;
---
<div class="faq">
  {heading && <h2>{heading}</h2>}
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <p>{i.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { max-width: 50rem; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 1.1rem 2.5rem 1.1rem 0; font-weight: 700; font-size: 1.08rem; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0.25rem; top: 0.85rem; font-size: 1.6rem; font-weight: 400; color: var(--fiber); transition: transform .2s ease; }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 0 0 1.2rem; color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { summary::after { transition: none; } }
</style>
