---
interface Props { title?: string; text?: string }
const {
  title = 'Scopri cosa arriva al tuo indirizzo',
  text = 'Lasciaci l\'indirizzo della sede: verifichiamo fibra, FTTC o radio e ti richiama un tecnico della zona.',
} = Astro.props;
---
<section class="cta">
  <div class="wrap cta__row">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="btn btn--signal" href="/verifica-copertura">Verifica copertura</a>
  </div>
</section>

<style>
  .cta { background: var(--ink); color: #fff; padding-block: clamp(3rem, 6vw, 4.5rem); }
  .cta__row { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta p { color: #c3d0df; margin: 0; }
  .cta h2 { margin-bottom: 0.4rem; }
</style>
