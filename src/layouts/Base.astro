---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SEDI } from '../data/site';
import ConsentHead from '../components/ConsentHead.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
  dark?: boolean;
}

const { title, description, jsonLd = [], noindex = false } = Astro.props;
const cleanPath = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: 'FibraHero by G8A',
  legalName: SITE.company,
  vatID: `IT${SITE.vat}`,
  taxID: SITE.vat,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  email: SITE.email,
  ...(SITE.phone ? { telephone: '+39 ' + SITE.phone } : {}),
  areaServed: ['Provincia di Varese', 'Città metropolitana di Milano', 'Provincia di Lecco'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SEDI[0].address,
    postalCode: SEDI[0].cap,
    addressLocality: SEDI[0].city,
    addressRegion: SEDI[0].province,
    addressCountry: 'IT',
  },
  // Scheda Google della sede G8A (Solbiate Arno): FibraHero non ha una scheda propria.
  parentOrganization: { '@type': 'Organization', name: SITE.company, url: 'https://www.g8a.it', sameAs: ['https://www.google.com/maps/place/?q=place_id:ChIJj7G_qVu2ImgR7SoyoB5PA5s'] },
};
const schemas = [organization, ...jsonLd];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Consenso cookie (Consent Mode v2 negato finché il visitatore non sceglie) e Microsoft Clarity solo dopo il consenso -->
    <ConsentHead />
    <!-- Google Tag Manager (GA4 dentro il contenitore rispetta il consenso) -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-KPVRPZQS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#070f22" />
    <link rel="icon" href="/logo-icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/logo-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="FibraHero by G8A" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#contenuto">Vai al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
    <script>
      // Comparsa al passaggio: elementi con data-reveal entrano quando arrivano a schermo.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
    <script>
      import '../scripts/motion';
    </script>
    <script is:inline>
      // Contatti: ogni clic su telefono, WhatsApp o email va nel dataLayer come evento "contatto" (GA4 via Tag Manager).
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!a) return;
        var h = a.getAttribute('href') || '';
        var canale = h.indexOf('tel:') === 0 ? 'telefono' : /wa\.me\/|api\.whatsapp\.com/.test(h) ? 'whatsapp' : h.indexOf('mailto:') === 0 ? 'email' : null;
        if (!canale) return;
        (window.dataLayer = window.dataLayer || []).push({ event: 'contatto', canale: canale, pagina: location.pathname });
      });
    </script>
    <ConsentBanner />
  </body>
</html>
